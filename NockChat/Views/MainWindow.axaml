<u:UrsaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:supportedView="using:NockChat.Views.Supported"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:view="using:NockChat.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NockChat.Views.MainWindow"
        CanMaximize="False"
        Title="NockChat"
        Width="1050" Height="700" 
        MinWidth="700" MinHeight="550"
        MaxWidth="1050" MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.ico">

    <u:UrsaWindow.RightContent>
        <supportedView:TitleBarRightContent />
    </u:UrsaWindow.RightContent>

    <view:MainView />
</u:UrsaWindow>