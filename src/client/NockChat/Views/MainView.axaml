<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:navigation="using:NockChat.Views.Supported"
             xmlns:styles="clr-namespace:NockChat.Styles"
             xmlns:vm="using:NockChat.ViewModels"
             x:Class="NockChat.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto * Auto">
        <styles:ConstellationCanvas IsActive="{Binding AppUiState.HasConnection, Mode=OneWay}"
                                   StarBrush="{DynamicResource ConstellationStarBrush}"
                                   HorizontalAlignment="Stretch" 
                                   VerticalAlignment="Stretch"
                                   IsHitTestVisible="False"
                                   Grid.RowSpan="3"/>

        <Image Source="/Assets/logo.ico" Width="200" Height="200" Grid.Row="0"/>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage, Mode=OneWay}" />

        <navigation:NavigationMenuView Grid.Row="2"
            IsVisible="{Binding AppUiState.IsActiveToggleMenu, Mode=OneWay}"/>
    </Grid>
</UserControl>